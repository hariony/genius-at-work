# Modèle du fichier /srv/gaw/.env du serveur de production (droits 600, propriétaire deploy).
# Copier, remplacer chaque valeur, ne JAMAIS committer le fichier rempli.
# Générer un secret : openssl rand -hex 32

APP_SECRET=
MYSQL_DATABASE=gaw
MYSQL_USER=gaw
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Brevo (API transactionnelle) : brevo+api://CLE@default
MAILER_DSN=
MAILER_FROM=noreply@genius-at-work.com
CONTACT_TEAM_EMAIL=contact@genius-at-work.com

# Domaine du back-office (route du tunnel Cloudflare vers http://api:8080).
ADMIN_HOST=office.genius-at-work.com

# Clé secrète du widget Turnstile de production (tableau de bord Cloudflare > Turnstile).
TURNSTILE_SECRET_KEY=

# Jeton du tunnel (Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
