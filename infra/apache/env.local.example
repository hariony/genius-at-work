# Modèle du fichier .env.local de l'API sur le serveur (dossier API_DIR, droits 600).
# Remplacer chaque valeur ; ne JAMAIS committer le fichier rempli.
# Générer un secret : openssl rand -hex 32

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=

DEFAULT_URI=https://api.genius-at-work.com
SITE_URL=https://genius-at-work.com
ADMIN_HOST=office.genius-at-work.com
CORS_ALLOW_ORIGIN='^https://genius-at-work\.com$'
# Apache reçoit les visiteurs directement (pas de proxy devant).
TRUSTED_PROXIES=127.0.0.1

# Base MariaDB 11.8 dédiée au nouveau site (identifiants fournis par l'hébergeur), toujours
# par 127.0.0.1:3306. Mot de passe en lettres et chiffres uniquement : un « % » serait lu par
# Symfony comme un paramètre.
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@127.0.0.1:3306/BASE?serverVersion=11.8.6-MariaDB&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Relais de l'hébergeur par sendmail (le port 25 est fermé aux comptes, même en local).
# Expéditeur : contact@genius-at-work.com uniquement.
MAILER_DSN=sendmail://default
MAILER_FROM=contact@genius-at-work.com
CONTACT_TEAM_EMAIL=contact@genius-at-work.com

# Clé secrète du widget Turnstile de production.
TURNSTILE_SECRET_KEY=
