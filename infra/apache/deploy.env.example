# Réglages de infra/apache/deploy.sh. Copier en deploy.env (non versionné) et adapter.
# Aucune valeur secrète ici : les secrets de l'API sont dans .env.local, sur le serveur.

# Alias SSH défini dans ~/.ssh/config (hôte, port, utilisateur, clé).
SSH_HOST=genius
# Options ssh supplémentaires, facultatives (ex. -F autre_config).
# SSH_OPTS=
# Dossiers sur le serveur, relatifs au dossier personnel du compte SSH.
API_DIR=gaw-api
SITE_DIR=public_html
# Adresses publiques.
API_URL=https://api.genius-at-work.com
SITE_URL=https://genius-at-work.com
# Clé de site Turnstile de production (publique, tableau de bord Cloudflare › Turnstile).
TURNSTILE_SITE_KEY=
# Sauvegardes de la base, sur ce poste (par défaut : backups/ à la racine du dépôt).
# BACKUP_DIR=
