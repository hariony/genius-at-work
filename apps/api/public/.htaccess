# API et back-office sous Apache (serveur sans Docker, docs/deploiement-apache.md) : toute
# adresse qui n'est pas un fichier existant passe par Symfony (public/index.php).
# Sous Docker (FrankenPHP), ce fichier est ignoré.

DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jamais de PHP exécuté depuis les images envoyées par le back-office.
    RewriteRule ^media/.*\.(php\d?|phtml|phar)$ - [F,L,NC]

    # Fichiers cachés (.env, .git…) : jamais servis.
    RewriteRule (^|/)\. - [F,L]

    # /index.php/xxx → /xxx : une seule adresse par page.
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) /$1 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
