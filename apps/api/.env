# Valeurs par défaut NON SECRÈTES, versionnées. Les vraies valeurs (production, clés)
# sont injectées par l'environnement ou placées dans .env.local (jamais commité).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
# Site public (lien « Voir le site » du back-office).
SITE_URL=http://127.0.0.1:4321
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
###< symfony/framework-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://gaw:gaw@127.0.0.1:3306/gaw?serverVersion=8.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=noreply@genius-at-work.com
CONTACT_TEAM_EMAIL=contact@genius-at-work.com
###< symfony/mailer ###

###> Cloudflare Turnstile ###
# Clé de test publique de Cloudflare : la vérification réussit toujours.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
###< Cloudflare Turnstile ###

###> symfony/brevo-mailer ###
# Production : MAILER_DSN=brevo+api://KEY@default (clé injectée sur le serveur, jamais ici).
###< symfony/brevo-mailer ###

###> Redis (Valkey) ###
# Cache applicatif en production (voir config/packages/cache.yaml). Docker : redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379
###< Redis (Valkey) ###
