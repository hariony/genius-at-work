{% extends 'admin/base.html.twig' %}

{% block body_class %}app{% endblock %}

{% block body %}
    <a class="skip-link" href="#main">Aller au contenu</a>
    <aside class="sidebar">
        <a class="brand" href="{{ path('admin_leads') }}">
            {% include 'admin/_logo.html.twig' with {size: 30} %}
            <span class="brand-name">genius<span class="brand-at">@</span>work</span>
        </a>
        <p class="sidebar-label">Back-office</p>
        {% set route = app.request.attributes.get('_route') %}
        <nav class="nav" aria-label="Navigation principale">
            <p class="nav-group">Suivi</p>
            <a class="nav-link" href="{{ path('admin_leads') }}"{% if route starts with 'admin_lead' %} aria-current="page"{% endif %}>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
                Demandes
            </a>
            <p class="nav-group">Contenu du site</p>
            <a class="nav-link" href="{{ path('admin_projects') }}"{% if route starts with 'admin_project' %} aria-current="page"{% endif %}>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                Projets
            </a>
            <a class="nav-link" href="{{ path('admin_services') }}"{% if route starts with 'admin_service' %} aria-current="page"{% endif %}>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
                Services
            </a>
            <a class="nav-link" href="{{ path('admin_pages') }}"{% if route starts with 'admin_page' %} aria-current="page"{% endif %}>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/></svg>
                Pages et textes
            </a>
            <a class="nav-link" href="{{ path('admin_settings') }}"{% if route == 'admin_settings' %} aria-current="page"{% endif %}>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M2 14h4"/><path d="M10 8h4"/><path d="M18 16h4"/></svg>
                Réglages
            </a>
        </nav>
        <div class="sidebar-foot">
            <a class="site-link" href="{{ site_url }}" target="_blank" rel="noopener">Voir le site ↗</a>
            <p class="user" title="{{ app.user.userIdentifier }}">{{ app.user.userIdentifier }}</p>
            <form method="post" action="{{ path('admin_logout') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button class="link-button" type="submit">Se déconnecter</button>
            </form>
        </div>
    </aside>

    <main id="main" class="main" tabindex="-1">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash flash--{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}
        {% block main %}{% endblock %}
    </main>
{% endblock %}
