# Site statique sous Apache (docs/deploiement-apache.md). Sur Cloudflare, voir _headers.
# Règle du serveur : /.well-known/ reste joignable en HTTP, sans redirection (Let's Encrypt).

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/en/#">
    ErrorDocument 404 /en/404.html
</If>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS et domaine sans « www », sauf pour le renouvellement du certificat.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://genius-at-work.com%{REQUEST_URI} [R=301,L]

    # Ancien site WordPress → nouvelles adresses (plan : docs/content-audit.md §13).
    # Réalisations : mêmes slugs, sauf deux corrigés.
    RewriteRule ^(en/)?portfolios/transparency-internationale/?$ /$1projects/transparency-international/ [R=301,L]
    RewriteRule ^(en/)?portfolios/euromputer/?$ /$1projects/eurocomputer/ [R=301,L]
    RewriteRule ^(en/)?portfolios/([a-z0-9-]+)/?$ /$1projects/$2/ [R=301,L]
    RewriteRule ^(en/)?portfolios/?$ /$1projects/ [R=301,L]

    # Catégories : la liste des réalisations, filtrée.
    RewriteRule ^(en/)?portfolios-categories/app-web/?$ /$1projects/?category=web-app [R=301,L]
    RewriteRule ^(en/)?portfolios-categories/design-ux-ui/?$ /$1projects/?category=ux-ui [R=301,L]
    RewriteRule ^(en/)?portfolios-categories/e-commerce/?$ /$1projects/?category=e-commerce [R=301,L]
    RewriteRule ^(en/)?portfolios-categories/innovation/?$ /$1projects/?category=innovation [R=301,L]
    RewriteRule ^(en/)?portfolios-categories/site-vitrine/?$ /$1projects/?category=showcase [R=301,L]
    RewriteRule ^(en/)?portfolios-categories/voyage/?$ /$1projects/?category=travel [R=301,L]
    RewriteRule ^(en/)?portfolios-categories(/.*)?$ /$1projects/ [R=301,L]

    # Anciennes pages de services (vides) → page du métier correspondant.
    RewriteRule ^(en/)?services/(creation-de-site-internet|website-creation)/?$ /$1services/websites/ [R=301,L]
    RewriteRule ^(en/)?services/(application-mobile|mobile-application)/?$ /$1services/mobile-apps/ [R=301,L]
    RewriteRule ^(en/)?services/(application-web|web-application)/?$ /$1services/web-apps/ [R=301,L]
    RewriteRule ^(en/)?services/(solution-logiciel-entreprise|business-software-solution)/?$ /$1services/business-software/ [R=301,L]
    RewriteRule ^(en/)?services/(solution-e-commerce|e-commerce-solution)/?$ /$1services/e-commerce/ [R=301,L]
    RewriteRule ^(en/)?services/(maintenance-evolution-et-hebergement|maintenance-evolution-and-hosting)/?$ /$1services/maintenance-hosting/ [R=301,L]

    # Technologies, équipe, conditions.
    RewriteRule ^(en/)?(portfolios-stacks|technos)(/.*)?$ /$1technology/ [R=301,L]
    RewriteRule ^(en/)?team(/.*)?$ /$1about/ [R=301,L]
    RewriteRule ^termes-et-conditions/?$ /legal/ [R=301,L]
    RewriteRule ^en/terms-and-conditions/?$ /en/legal/ [R=301,L]
    RewriteRule ^home-fr/?$ / [R=301,L]
    RewriteRule ^en/home-en/?$ /en/ [R=301,L]

    # Pages WordPress sans équivalent : définitivement retirées.
    RewriteRule ^(en/)?(bonjour-tout-le-monde|author|category|feed|comments/feed)(/.*)?$ - [G,L]
    RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json)(/.*)?$ - [G,L]
    RewriteRule ^(wp-login|xmlrpc|wp-cron)\.php$ - [G,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # La CSP complète est dans une <meta> de chaque page (Astro) ; ici, les directives qu'une
    # <meta> ignore.
    Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"

    # Fichiers versionnés par Astro (nom contenant une empreinte) : cache permanent.
    <If "%{REQUEST_URI} =~ m#^/_astro/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    # Cartes Open Graph : régénérées à chaque publication.
    <ElseIf "%{REQUEST_URI} =~ m#^/og/#">
        Header set Cache-Control "public, max-age=86400"
    </ElseIf>
    # Pages : toujours revalidées, pour qu'une publication se voie tout de suite.
    <Else>
        Header set Cache-Control "no-cache"
    </Else>

    <If "%{REQUEST_URI} =~ m#^/design-system/#">
        Header set X-Robots-Tag "noindex"
    </If>
</IfModule>

<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>
