# Copier en .env pour le développement local. Uniquement des valeurs publiques (PUBLIC_*).
PUBLIC_SITE_URL=http://127.0.0.1:4321
# API Symfony (apps/api), lancée en local avec : docker compose up -d --wait
# Le contenu du site (géré dans le back-office) y est lu au build et à chaque page en dev.
PUBLIC_API_URL=http://127.0.0.1:8088
# Clé de site de test publique de Cloudflare Turnstile (widget visible, réussit toujours).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Facultatif : URL de l'API pour lire le contenu au build, si elle diffère de PUBLIC_API_URL.
# CONTENT_API_URL=
# Facultatif (CI) : fichier JSON lu à la place de l'API (apps/api/data/site-content.snapshot.json).
# CONTENT_SNAPSHOT=
