---
import { Picture } from 'astro:assets';
import { HOME_SECTIONS } from '@/content/home';
import { imageSource } from '@/lib/images';
import { toLocale } from '@/lib/i18n';
import { getFeaturedProjects, getProjects } from '@/services/content';

/**
 * Visuel du hero : deux captures de projets réels sur des aplats de marque (cyan, lilas),
 * et le nombre de projets publiés. Décoratif : les projets sont présentés juste en dessous.
 * La scène « hero-collage » fait entrer les pièces une seule fois.
 */
const locale = toLocale(Astro.currentLocale);
const copy = HOME_SECTIONS[locale].hero;
const [front, back] = getFeaturedProjects();
const badge = copy.badge.replace('{n}', String(getProjects().length));
---

<div
  class="hero-collage relative mx-auto aspect-[5/4] w-full max-w-[36rem]"
  data-scene="hero-collage"
>
  <span
    class="absolute top-0 right-[2%] aspect-square w-[58%] rounded-pill bg-cyan"
    aria-hidden="true"
    data-piece="shape"
  ></span>
  <span
    class="absolute bottom-[4%] left-[4%] aspect-square w-[40%] -rotate-8 rounded-xl bg-lilac"
    aria-hidden="true"
    data-piece="shape"
  ></span>
  {back && (
    <div
      class="browser-frame absolute top-[8%] left-[2%] w-[78%] -rotate-3 shadow-lg"
      data-piece="shot"
    >
      <Picture
        {...imageSource(back.cover)}
        formats={['avif', 'webp']}
        widths={[480, 720, 960]}
        sizes="(min-width: 64rem) 28rem, 78vw"
        alt=""
        loading="eager"
        class="aspect-[16/10] w-full object-cover object-top"
      />
    </div>
  )}
  {front && (
    <div
      class="browser-frame absolute right-0 bottom-[2%] w-[66%] rotate-3 shadow-lg"
      data-piece="shot"
    >
      <Picture
        {...imageSource(front.cover)}
        formats={['avif', 'webp']}
        widths={[480, 720, 960]}
        sizes="(min-width: 64rem) 24rem, 66vw"
        alt=""
        loading="eager"
        class="aspect-[16/10] w-full object-cover object-top"
      />
    </div>
  )}
  <p
    data-surface="dark"
    class="absolute bottom-[14%] left-0 rounded-pill bg-bg px-4 py-2 text-small font-bold text-spark shadow-md"
    data-piece="badge"
  >
    {badge}
  </p>
</div>
