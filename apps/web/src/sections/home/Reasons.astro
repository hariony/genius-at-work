---
import Container from '@/components/ui/Container.astro';
import { HOME_SECTIONS } from '@/content/home';
import { REASONS } from '@/content/process';
import { toLocale } from '@/lib/i18n';

/**
 * Ce qui distingue l'agence, en composition éditoriale : le titre reste en place à gauche
 * pendant que les six points, numérotés, défilent à droite. Une colonne sur mobile.
 */
interface Props {
  /** Textes d'en-tête ; par défaut ceux de l'accueil. */
  heading?: { label: string; title: string; intro?: string } | undefined;
  /** Numéro de la section dans le parcours de la page. */
  index?: string | undefined;
  surface?: 'base' | 'subtle' | undefined;
}

const locale = toLocale(Astro.currentLocale);
const { heading, index, surface = 'base' } = Astro.props;
const copy: NonNullable<Props['heading']> = heading ?? HOME_SECTIONS[locale].reasons;
---

<section data-surface={surface} class="py-section" aria-labelledby="reasons-title">
  <Container class="grid gap-section-gap lg:grid-cols-12 lg:gap-x-12">
    <header class="flex flex-col gap-4 self-start lg:sticky lg:top-28 lg:col-span-4">
      <p class="eyebrow" data-anim="reveal-up">
        {index && <span class="text-fg">{index}</span>}
        {copy.label}
      </p>
      <h2 id="reasons-title" class="type-h2 max-w-[16ch]" data-anim="reveal-lines">
        {copy.title}
      </h2>
      {copy.intro && <p class="max-w-[40ch] text-fg-muted">{copy.intro}</p>}
    </header>

    <ol class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8" data-anim="stagger">
      {REASONS.map((reason, i) => (
        <li class="flex flex-col gap-2.5 border-t border-border py-7">
          <span class="type-mono text-highlight">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="type-h3">{reason.title[locale]}</h3>
          <p class="max-w-[40ch] text-fg-muted">{reason.description[locale]}</p>
        </li>
      ))}
    </ol>
  </Container>
</section>
