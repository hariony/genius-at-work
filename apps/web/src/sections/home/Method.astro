---
import { markerTint } from '@/lib/brand';
import ChapterHeader from '@/components/sections/ChapterHeader.astro';
import Container from '@/components/ui/Container.astro';
import { HOME_SECTIONS } from '@/content/home';
import { PROCESS } from '@/content/process';
import { toLocale } from '@/lib/i18n';

/** Méthode en quatre temps, lue de gauche à droite (de haut en bas sur mobile). */
interface Props {
  /** Textes d'en-tête ; par défaut ceux de l'accueil. */
  heading?: { label: string; title: string; intro?: string } | undefined;
  surface?: 'base' | 'subtle' | undefined;
}

const locale = toLocale(Astro.currentLocale);
const { heading, surface = 'subtle' } = Astro.props;
const copy = heading ?? HOME_SECTIONS[locale].method;
---

<section data-surface={surface} class="py-section" aria-labelledby="method-title">
  <Container class="flex flex-col gap-section-gap">
    <ChapterHeader label={copy.label} title={copy.title} intro={copy.intro} id="method-title" />

    <ol class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4" data-anim="stagger">
      {PROCESS.map((step, i) => (
        <li class="flex flex-col gap-3 border-t border-border-strong pt-6">
          <span
            class:list={[
              'grid size-9 place-items-center rounded-pill text-small font-extrabold text-ink tabular-nums',
              markerTint(i),
            ]}
          >
            {i + 1}
          </span>
          <h3 class="type-h3 mt-2">{step.title[locale]}</h3>
          <p class="max-w-[34ch] text-fg-muted">{step.description[locale]}</p>
        </li>
      ))}
    </ol>
  </Container>
</section>
