---
import ChapterHeader from '@/components/sections/ChapterHeader.astro';
import Container from '@/components/ui/Container.astro';
import { AI_PAGE } from '@/content/ai';
import { toLocale } from '@/lib/i18n';

/** Capacités IA : une ligne par domaine (numéro, titre, description, exemples). */
interface Props {
  /** Numéro de la section dans le parcours de la page. */
  index?: string | undefined;
}

const { index } = Astro.props;
const copy = AI_PAGE[toLocale(Astro.currentLocale)].capabilities;
---

<section data-surface="base" class="py-section" aria-labelledby="ai-capabilities-title">
  <Container class="flex flex-col gap-section-gap">
    <ChapterHeader
      index={index}
      label={copy.label}
      title={copy.title}
      intro={copy.intro}
      id="ai-capabilities-title"
    />
    <ol class="border-t border-border-strong" data-anim="stack">
      {copy.items.map((item, i) => (
        <li class="capability grid gap-x-10 gap-y-3 border-b border-border py-8 lg:grid-cols-12">
          <span class="type-mono text-fg-muted tabular-nums lg:col-span-1 lg:pt-1.5">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="type-h3 lg:col-span-4">{item.title}</h3>
          <p class="max-w-[46ch] text-fg-muted lg:col-span-4">{item.description}</p>
          <ul class="type-mono flex flex-wrap gap-x-3 gap-y-1 text-fg-muted lg:col-span-3 lg:flex-col lg:pt-1">
            {item.examples.map((example) => (
              <li>{example}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </Container>
</section>

<style>
  .capability {
    transition: background-color var(--duration-base) var(--ease-out);
  }
  @media (hover: hover) {
    .capability:hover h3 {
      color: var(--surface-accent);
    }
  }
</style>
