---
import ChapterHeader from '@/components/sections/ChapterHeader.astro';
import Container from '@/components/ui/Container.astro';
import { AI_PAGE } from '@/content/ai';
import { toLocale } from '@/lib/i18n';

/** Cas d'usage : des problèmes métier concrets (cible du lien « Voir les cas d'usage »). */
const copy = AI_PAGE[toLocale(Astro.currentLocale)].useCases;
---

<section
  id="use-cases"
  data-surface="subtle"
  class="scroll-mt-20 py-section"
  aria-labelledby="ai-use-cases-title"
>
  <Container class="flex flex-col gap-section-gap">
    <ChapterHeader
      label={copy.label}
      title={copy.title}
      intro={copy.intro}
      id="ai-use-cases-title"
    />
    <ul class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-anim="stagger">
      {copy.items.map((item, i) => (
        <li class="flex flex-col gap-3 border-t border-border-strong pt-6">
          <span class="type-mono text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="type-h3">{item.title}</h3>
          <p class="max-w-[38ch] text-fg-muted">{item.description}</p>
        </li>
      ))}
    </ul>
  </Container>
</section>
