---
import { Picture } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import Container from '@/components/ui/Container.astro';
import { PROJECTS_PAGE } from '@/content/pages';
import { tintStyle } from '@/lib/brand';
import { localizePath, toLocale } from '@/lib/i18n';
import { imageSource } from '@/lib/images';
import { categoryLabel, projectPeriod } from '@/lib/portfolio';
import { filterCategories, getProjects } from '@/services/content';

/**
 * Liste éditoriale des réalisations, filtrable par catégorie : une ligne par projet (numéro,
 * titre, client, catégories, période). Avec une souris, la capture du projet survolé suit le
 * curseur ; sans souris (mobile, tablette), elle est affichée dans la ligne.
 * Sans JS, tout est affiché. Le filtre actif est reflété dans l'URL (?category=…), ce qui
 * reprend les anciennes URL de catégories redirigées.
 */
const locale = toLocale(Astro.currentLocale);
const copy = PROJECTS_PAGE[locale];
const projects = getProjects();
const categories = filterCategories().map((category) => ({
  category,
  count: projects.filter((project) => project.categories.includes(category)).length,
}));
---

<section
  data-surface="base"
  class="pt-12 pb-section lg:pt-16"
  aria-label={copy.hero.eyebrow}
  data-project-filter
>
  <Container width="wide" class="flex flex-col gap-section-gap">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-wrap gap-2" role="group" aria-label={copy.filterLabel}>
        <button type="button" class="chip" data-filter="all" aria-pressed="true">
          {copy.all}
          <sup class="chip-count" aria-hidden="true">
            {projects.length}
          </sup>
        </button>
        {categories.map(({ category, count }) => (
          <button type="button" class="chip" data-filter={category} aria-pressed="false">
            {categoryLabel(category, locale)}
            <sup class="chip-count" aria-hidden="true">
              {count}
            </sup>
          </button>
        ))}
      </div>
      <p
        class="type-mono text-fg-muted"
        aria-live="polite"
        data-filter-status
        data-one={copy.count(1)}
        data-many={copy.count(2).replace('2', '{n}')}
      >
        {copy.count(projects.length)}
      </p>
    </div>

    <ol class="project-list relative border-t border-border-strong" data-project-list>
      {projects.map((project, i) => {
        const period = projectPeriod(project);
        return (
          <li data-categories={project.categories.join(' ')} class="border-b border-border">
            <a
              href={localizePath(`/projects/${project.slug}/`, locale)}
              class="project-row group grid gap-x-8 gap-y-3 py-6 no-underline md:grid-cols-[4rem_minmax(0,1fr)_minmax(0,16rem)_6rem_2rem] md:items-center md:py-7"
            >
              <span class="type-mono hidden text-fg-muted md:block">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="flex flex-col gap-1">
                <span class="project-row__title text-[clamp(1.5rem,1.2rem+1.3vw,2.375rem)] leading-[1.1] font-extrabold tracking-[-0.03em]">
                  {project.title}
                </span>
                {project.client && project.client !== project.title && (
                  <span class="text-small text-fg-muted">{project.client}</span>
                )}
              </span>
              <span class="type-mono text-fg-muted">
                {project.categories.map((category) => categoryLabel(category, locale)).join(' · ')}
              </span>
              <span class="type-mono text-fg-muted md:text-right">{period}</span>
              <span class="hidden justify-self-end md:block" aria-hidden="true">
                <Icon name="arrow-up-right" size={20} />
              </span>
              <span
                class="project-row__preview project-tint order-first overflow-hidden rounded-md md:order-none"
                style={tintStyle(project)}
                aria-hidden="true"
              >
                <span class="browser-frame absolute inset-x-[8%] top-[10%] -bottom-[8%]">
                  <Picture
                    {...imageSource(project.cover)}
                    formats={['avif', 'webp']}
                    widths={[400, 640, 800]}
                    sizes="(hover: hover) and (pointer: fine) 22rem, 100vw"
                    alt=""
                    loading="lazy"
                    class="size-full object-cover object-top"
                  />
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </Container>
</section>

<style>
  /* Nombre de projets de la catégorie, en exposant (le compte filtré est annoncé à part). */
  .chip-count {
    margin-left: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    opacity: 0.7;
  }

  /* Aperçu : dans la ligne par défaut (mobile, tablette, clavier). */
  .project-row__preview {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
  }

  .project-row__title {
    transition:
      transform var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  /*
   * Souris : l'aperçu flotte et suit le curseur (position posée par le script dans
   * --preview-x / --preview-y sur la liste). Seul celui de la ligne survolée est visible.
   */
  @media (hover: hover) and (pointer: fine) and (min-width: 48rem) {
    .project-row__preview {
      position: absolute;
      z-index: 2;
      top: 0;
      left: 0;
      width: 22rem;
      pointer-events: none;
      opacity: 0;
      transform: translate3d(var(--preview-x, 0), var(--preview-y, 0), 0) rotate(-2deg);
      scale: 0.92;
      transition:
        opacity var(--duration-base) var(--ease-out),
        scale var(--duration-base) var(--ease-out);
      box-shadow: var(--shadow-lg);
    }

    .project-row:hover .project-row__preview {
      opacity: 1;
      scale: 1;
    }

    .project-row:hover .project-row__title {
      transform: translateX(0.5rem);
      color: var(--surface-accent);
    }
  }
</style>

<script>
  import { LAYOUT_CHANGE_EVENT, MOTION_OK_QUERY } from '@/animations/core/motion';

  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-project-filter]');
    if (!root) return;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-categories]'));
    const status = root.querySelector<HTMLElement>('[data-filter-status]');

    const apply = (category: string, updateUrl: boolean) => {
      const known = buttons.some((button) => button.dataset.filter === category);
      const active = known ? category : 'all';
      let visible = 0;
      for (const item of items) {
        const match =
          active === 'all' || (item.dataset.categories ?? '').split(' ').includes(active);
        item.hidden = !match;
        if (match) visible += 1;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === active));
      }
      if (status) {
        const template = visible > 1 ? status.dataset.many : status.dataset.one;
        status.textContent = (template ?? '').replace('{n}', String(visible));
      }
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (active === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', active);
        history.replaceState(history.state, '', url);
      }
      document.dispatchEvent(new CustomEvent(LAYOUT_CHANGE_EVENT));
    };

    for (const button of buttons) {
      button.addEventListener('click', () => apply(button.dataset.filter ?? 'all', true));
    }
    const initial = new URL(window.location.href).searchParams.get('category');
    if (initial) apply(initial, false);
  };

  /** L'aperçu suit le curseur, avec un léger retard (aucun retard en mouvement réduit). */
  const followCursor = () => {
    const list = document.querySelector<HTMLElement>('[data-project-list]');
    if (!list || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    const smooth = window.matchMedia(MOTION_OK_QUERY).matches;
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    let frame = 0;

    const render = () => {
      const ease = smooth ? 0.18 : 1;
      current.x += (target.x - current.x) * ease;
      current.y += (target.y - current.y) * ease;
      list.style.setProperty('--preview-x', `${current.x.toFixed(1)}px`);
      list.style.setProperty('--preview-y', `${current.y.toFixed(1)}px`);
      const settled = Math.abs(target.x - current.x) < 0.5 && Math.abs(target.y - current.y) < 0.5;
      frame = settled ? 0 : requestAnimationFrame(render);
    };

    list.addEventListener(
      'pointermove',
      (event) => {
        const rect = list.getBoundingClientRect();
        // Aperçu (22rem, 16:10) centré sur le curseur, décalé vers la droite.
        target.x = event.clientX - rect.left + 32;
        target.y = event.clientY - rect.top - 110;
        if (!frame) frame = requestAnimationFrame(render);
      },
      { passive: true },
    );
  };

  init();
  followCursor();
</script>
