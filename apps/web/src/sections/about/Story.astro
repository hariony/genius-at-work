---
import Container from '@/components/ui/Container.astro';
import { HOME_SECTIONS } from '@/content/home';
import { ABOUT_PAGE } from '@/content/pages';
import { toLocale } from '@/lib/i18n';

/** L'équipe : récit et chiffres réels (audit §3). */
interface Props {
  /** Numéro de la section dans le parcours de la page. */
  index?: string | undefined;
}

const { index } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const copy = ABOUT_PAGE[locale].story;
const stats = HOME_SECTIONS[locale].manifesto.stats;
---

<section data-surface="base" class="py-section" aria-labelledby="story-title">
  <Container class="flex flex-col gap-section-gap">
    <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-12">
      <div class="flex flex-col gap-4 lg:col-span-5">
        <p class="eyebrow" data-anim="reveal-up">
          {index && <span class="text-fg">{index}</span>}
          {copy.label}
        </p>
        <h2 id="story-title" class="type-h2 max-w-[18ch]" data-anim="reveal-lines">
          {copy.title}
        </h2>
      </div>
      <div class="flex flex-col gap-5 lg:col-span-7 lg:pt-10">
        {copy.paragraphs.map((paragraph, i) => (
          <p class:list={[i === 0 ? 'type-lead text-fg' : 'text-fg-muted']} data-anim="reveal-up">
            {paragraph}
          </p>
        ))}
      </div>
    </div>
    <dl class="grid grid-cols-3 gap-x-6 gap-y-8 md:gap-x-8" data-anim="stagger">
      {stats.map((stat) => (
        <div class="flex flex-col-reverse gap-1.5 border-t border-border pt-5">
          <dt class="text-small text-fg-muted">{stat.label}</dt>
          <dd class="type-h1 tabular-nums">
            {stat.value}
            {stat.suffix && <span class="text-highlight">{stat.suffix}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
