---
/** Étiquette « système » (technologie, catégorie) : chasse fixe, contour fin. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={[
    'type-mono inline-flex items-center rounded-xs border border-border-strong px-2 py-1 text-fg-muted',
    className,
  ]}
>
  <slot />
</span>
