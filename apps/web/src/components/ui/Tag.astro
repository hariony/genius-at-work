---
/** Étiquette discrète (technologie, catégorie) : fond teinté, sans bordure appuyée. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-xs bg-fg/5 px-2 py-0.5 text-[0.8125rem] leading-6 font-medium text-fg-muted',
    className,
  ]}
>
  <slot />
</span>
