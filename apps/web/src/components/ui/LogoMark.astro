---
/**
 * Monogramme « G » : l'arc et le bloc du favicon historique, redessinés en vectoriel.
 * L'arc suit la couleur du texte (encre sur clair, clair sur sombre) ; le bloc reste cyan.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M47.56 16.44A22 22 0 1 0 54 32"
    fill="none"
    stroke="currentColor"
    stroke-width="11"
  ></path>
  <path d="M31 26.5h16l8 11H31z" fill="var(--color-cyan)"></path>
</svg>
