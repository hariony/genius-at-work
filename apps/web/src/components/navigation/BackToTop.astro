---
import Icon from '@/components/ui/Icon.astro';
import { toLocale, useTranslations } from '@/lib/i18n';

/**
 * Bouton flottant « Retour en haut », sur toutes les pages (PageLayout). Il apparaît après
 * environ 400 px de défilement et se pose au-dessus de la dernière ligne du pied de page
 * quand elle entre à l'écran. Sans écouteur de défilement permanent : deux
 * IntersectionObserver ; le calcul ne suit le défilement que pendant que le pied de page
 * est visible. Sans JavaScript, il reste masqué.
 */
const t = useTranslations(toLocale(Astro.currentLocale));
const label = t('a11y.backToTop');
---

<button type="button" class="back-to-top" aria-label={label} data-back-to-top>
  <Icon name="arrow-up" size={20} />
  <span class="back-to-top-tip" aria-hidden="true">
    {label}
  </span>
</button>

<style>
  .back-to-top {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: var(--z-sticky);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-paper);
    /* Liseré clair : le bouton se détache aussi sur les sections navy et bleues. */
    box-shadow:
      0 0 0 2px var(--color-paper),
      var(--shadow-md);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.75rem);
    translate: 0 calc(-1 * var(--lift, 0px));
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      visibility 0s linear var(--duration-base),
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  @media (min-width: 64rem) {
    .back-to-top {
      right: max(2rem, env(safe-area-inset-right));
      bottom: max(2rem, env(safe-area-inset-bottom));
    }
  }

  .back-to-top[data-visible] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  /* Survol et focus clavier : le citron, comme les autres survols du site. */
  .back-to-top:hover,
  .back-to-top:focus-visible {
    background: var(--color-lime);
    color: var(--color-ink);
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 4px;
  }

  .back-to-top:active {
    transform: scale(0.94);
  }

  /* Info-bulle : affichée au survol et au focus clavier ; le nom accessible est aria-label. */
  .back-to-top-tip {
    position: absolute;
    right: calc(100% + 0.75rem);
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateX(0.25rem);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .back-to-top:focus-visible .back-to-top-tip {
    opacity: 1;
    transform: none;
  }

  @media (hover: hover) {
    .back-to-top:hover .back-to-top-tip {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (button) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Repère en haut du document, haut de 400 px : tant qu'il est visible, le bouton reste
    // masqué. Il reçoit aussi le focus au retour en haut : la touche Tab repart du début.
    const top = document.createElement('div');
    top.tabIndex = -1;
    top.style.cssText =
      'position:absolute;top:0;left:0;width:1px;height:400px;pointer-events:none;outline:none';
    document.body.prepend(top);
    new IntersectionObserver(([entry]) => {
      button.toggleAttribute('data-visible', !entry?.isIntersecting);
    }).observe(top);

    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduced.matches ? 'auto' : 'smooth' });
      top.focus({ preventScroll: true });
    });

    // Dernière ligne du pied de page (liens, langue) : le bouton remonte pour ne pas la couvrir.
    const end = document.querySelector<HTMLElement>('[data-footer-end]');
    if (end) {
      let frame = 0;
      const lift = () => {
        frame = 0;
        const overlap = window.innerHeight - end.getBoundingClientRect().top;
        button.style.setProperty('--lift', `${Math.max(0, Math.round(overlap))}px`);
      };
      const schedule = () => {
        frame ||= requestAnimationFrame(lift);
      };
      new IntersectionObserver(([entry]) => {
        if (entry?.isIntersecting) {
          window.addEventListener('scroll', schedule, { passive: true });
          window.addEventListener('resize', schedule);
          lift();
        } else {
          window.removeEventListener('scroll', schedule);
          window.removeEventListener('resize', schedule);
          button.style.removeProperty('--lift');
        }
      }).observe(end);
    }
  }
</script>
