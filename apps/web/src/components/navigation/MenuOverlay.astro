---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Wordmark from '@/components/ui/Wordmark.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { SITE } from '@/content/site';
import { localizePath, stripLocale, toLocale, useTranslations } from '@/lib/i18n';
import { activeNavPath, CONTACT_PATH, MAIN_NAV } from '@/lib/navigation';

/**
 * Menu mobile et tablette. <dialog> natif : focus piégé, Échap et retour du focus au
 * déclencheur sont fournis par le navigateur.
 */
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const activePath = activeNavPath(stripLocale(Astro.url.pathname));
---

<dialog
  id="site-menu"
  data-surface="base"
  aria-label={t('a11y.mainNav')}
  class="menu-dialog m-0 h-dvh max-h-none w-full max-w-none overflow-y-auto border-0 p-0 backdrop:bg-transparent"
>
  <div class="flex min-h-full flex-col px-gutter pb-8">
    <div class="flex h-[4.5rem] lg:h-20 items-center justify-between">
      <Wordmark size={40} class="text-[1.375rem] lg:text-[1.5rem]" />
      <button
        type="button"
        data-menu-close
        class="inline-flex min-h-11 items-center gap-2 rounded-pill px-3 text-small font-semibold"
      >
        {t('nav.close')}
        <Icon name="close" size={18} />
      </button>
    </div>

    <nav class="mt-10 flex-1" aria-label={t('a11y.mainNav')}>
      <ul class="flex flex-col border-t border-border">
        {MAIN_NAV.map((item) => (
          <li class="border-b border-border">
            <a
              href={localizePath(item.path, locale)}
              aria-current={item.path === activePath ? 'page' : undefined}
              class="flex items-center justify-between py-4 text-[1.625rem] leading-tight font-semibold tracking-[-0.02em] no-underline aria-[current=page]:text-accent"
            >
              {t(item.key)}
              <Icon name="arrow-right" size={20} class="text-fg-muted" />
            </a>
          </li>
        ))}
      </ul>
      <Button href={localizePath(CONTACT_PATH, locale)} variant="accent" class="mt-8 w-full">
        {t('cta.discussProject')}
      </Button>
    </nav>

    <div class="mt-12 flex flex-col gap-6 text-small">
      {SITE.offices.map((office) => (
        <div class="flex flex-col gap-1">
          <p class="type-label text-fg-muted">{office.name[locale]}</p>
          {office.phones.map((phone) => (
            <a href={`tel:${phone.e164}`} class="tabular-nums no-underline">
              {phone.display}
            </a>
          ))}
        </div>
      ))}
      <div class="flex items-center justify-between gap-4 border-t border-border pt-6">
        <a href={`mailto:${SITE.email}`} class="no-underline">
          {SITE.email}
        </a>
        <LanguageSwitcher />
      </div>
    </div>
  </div>
</dialog>

<style>
  .menu-dialog[open] {
    animation: menu-in var(--duration-base) var(--ease-out);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDialogElement>('#site-menu');
  if (menu) {
    document.querySelectorAll<HTMLButtonElement>('[data-menu-open]').forEach((button) => {
      button.addEventListener('click', () => {
        menu.showModal();
        button.setAttribute('aria-expanded', 'true');
      });
    });
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
    menu.addEventListener('close', () => {
      document
        .querySelectorAll('[data-menu-open]')
        .forEach((button) => button.setAttribute('aria-expanded', 'false'));
    });
    // Un lien suivi ferme le menu avant la transition de page.
    menu
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', () => menu.close()));
  }
</script>
