---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Wordmark from '@/components/ui/Wordmark.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MenuOverlay from './MenuOverlay.astro';
import { localizePath, stripLocale, toLocale, useTranslations } from '@/lib/i18n';
import { activeNavPath, CONTACT_PATH, MAIN_NAV } from '@/lib/navigation';

/**
 * En-tête. En haut de page : pleine largeur, transparent. Dès 16 px de défilement, il se
 * resserre en une barre flottante arrondie (fond papier translucide, flou léger, ombre fine).
 * Il reste toujours visible : l'action « Parler de votre projet » est à portée à tout moment,
 * et passe en couleur d'action une fois la barre compacte.
 */
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const activePath = activeNavPath(stripLocale(Astro.url.pathname));
---

<header data-site-header class="site-header fixed inset-x-0 top-0 z-[var(--z-nav)] text-fg">
  <div class="header-bar mx-auto flex items-center justify-between gap-4">
    <a href={localizePath('/', locale)} class="header-logo no-underline">
      <Wordmark size={36} class="text-[1.3125rem] lg:text-[1.375rem]" />
    </a>

    <nav aria-label={t('a11y.mainNav')} class="hidden lg:block">
      <ul class="flex items-center">
        {MAIN_NAV.map((item) => {
          const active = item.path === activePath;
          return (
            <li>
              <a
                href={localizePath(item.path, locale)}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'nav-link relative inline-flex h-9 items-center rounded-pill px-3 text-small font-medium whitespace-nowrap no-underline xl:px-3.5',
                  active ? 'text-fg' : 'text-fg-muted',
                ]}
              >
                {t(item.key)}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2 lg:gap-4">
      <div class="hidden lg:block">
        <LanguageSwitcher />
      </div>
      <!-- Sur petit écran, l'action est dans le menu (la barre n'a pas la place). -->
      <div class="hidden sm:block">
        <Button href={localizePath(CONTACT_PATH, locale)} size="sm" class="header-cta">
          {t('cta.discussProject')}
        </Button>
      </div>
      <button
        type="button"
        data-menu-open
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="site-menu"
        class="inline-flex min-h-11 items-center gap-2 rounded-pill px-3 text-small font-semibold lg:hidden"
      >
        {t('nav.menu')}
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>
</header>

<MenuOverlay />

<style>
  .header-bar {
    max-width: var(--container-content);
    height: 4.5rem;
    padding-inline: var(--spacing-gutter);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    transition:
      max-width var(--duration-slow) var(--ease-out-expo),
      height var(--duration-slow) var(--ease-out-expo),
      margin var(--duration-slow) var(--ease-out-expo),
      padding var(--duration-slow) var(--ease-out-expo),
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }

  @media (min-width: 64rem) {
    .header-bar {
      height: 5rem;
    }
  }

  /* Barre compacte : flottante, translucide, à 12 px du haut. */
  [data-scrolled] .header-bar {
    max-width: min(68rem, calc(100% - 1.5rem));
    height: 3.5rem;
    margin-top: 0.75rem;
    padding-inline: 1rem 0.375rem;
    border-color: var(--surface-border);
    background: color-mix(in srgb, var(--surface-bg) 90%, transparent);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }

  .header-logo {
    transform-origin: left center;
    transition: scale var(--duration-slow) var(--ease-out-expo);
  }
  [data-scrolled] .header-logo {
    scale: 0.88;
  }

  /* Lien : pastille légère au survol ; page active : point d'action sous le libellé. */
  .nav-link {
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }
  .nav-link:hover {
    color: var(--surface-fg);
    background: color-mix(in srgb, var(--surface-fg) 6%, transparent);
  }
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.125rem;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 999px;
    background: var(--surface-accent);
  }

  /* L'action passe en couleur d'action dans la barre compacte. */
  [data-scrolled] :global(.header-cta) {
    background: var(--surface-accent);
    color: var(--surface-accent-fg);
  }
  [data-scrolled] :global(.header-cta:hover) {
    background: color-mix(in srgb, var(--surface-accent) 90%, transparent);
  }
</style>

<script>
  const SCROLLED_AT = 16;

  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (header) {
    const update = () => {
      const y = window.scrollY;
      header.toggleAttribute('data-scrolled', y > SCROLLED_AT);
      // Hero sombre : l'en-tête garde sa surface tant qu'il le recouvre.
      header.toggleAttribute(
        'data-past-hero',
        !hero || y > hero.offsetTop + hero.offsetHeight - header.offsetHeight,
      );
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
