---
import JsonLd from '@/components/seo/JsonLd.astro';
import Container from '@/components/ui/Container.astro';
import { breadcrumbs as breadcrumbList } from '@/lib/seo/schema';

/**
 * En-tête des pages intérieures : clair, aligné sur la grille du contenu.
 * Le fil d'Ariane est facultatif (pages de détail) ; le slot par défaut accueille
 * un contenu complémentaire (actions…).
 * Variante `large` (pages d'index) : titre en taille display, chapô à droite sur grand écran.
 */
interface Crumb {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  lead?: string | undefined;
  breadcrumbs?: Crumb[] | undefined;
  breadcrumbLabel?: string | undefined;
  size?: 'default' | 'large' | undefined;
}

const { eyebrow, title, lead, breadcrumbs, breadcrumbLabel, size = 'default' } = Astro.props;
const large = size === 'large';
const site = Astro.site ?? new URL('https://genius-at-work.com');
---

{breadcrumbs && (
  <JsonLd
    data={breadcrumbList(site, [...breadcrumbs, { label: title, href: Astro.url.pathname }])}
  />
)}
<section data-surface="base" class="border-b border-border">
  <Container
    class:list={[
      'flex flex-col gap-6 pt-32 pb-16 lg:pt-40 lg:pb-20',
      large && 'lg:grid lg:grid-cols-12 lg:items-end lg:gap-x-12 lg:pt-44 lg:pb-24',
    ]}
  >
    {breadcrumbs && (
      <nav
        aria-label={breadcrumbLabel}
        class:list={['text-small text-fg-muted', large && 'lg:col-span-12']}
      >
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          {breadcrumbs.map((crumb) => (
            <li class="flex items-center gap-2">
              <a href={crumb.href} class="no-underline hover:text-fg">
                {crumb.label}
              </a>
              <span aria-hidden="true" class="text-border-strong">
                /
              </span>
            </li>
          ))}
          <li aria-current="page" class="text-fg">
            {title}
          </li>
        </ol>
      </nav>
    )}
    <div class:list={['flex flex-col gap-6', large && 'lg:col-span-7']}>
      <p class="eyebrow" data-anim="reveal-up" data-anim-trigger="load">
        {eyebrow}
      </p>
      <h1
        class:list={[large ? 'type-display max-w-[16ch]' : 'type-h1 max-w-[22ch]']}
        data-anim="reveal-lines"
        data-anim-trigger="load"
      >
        {title}
      </h1>
    </div>
    {(lead || Astro.slots.has('default')) && (
      <div class:list={['flex flex-col gap-6', large && 'lg:col-span-5 lg:pb-2']}>
        {lead && (
          <p
            class="type-lead max-w-[56ch]"
            data-anim="reveal-up"
            data-anim-trigger="load"
            data-anim-delay="0.2"
          >
            {lead}
          </p>
        )}
        <slot />
      </div>
    )}
  </Container>
</section>
