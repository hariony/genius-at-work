---
/**
 * En-tête de section : surtitre (puce + libellé), titre h2 et introduction facultative.
 * Le slot « aside » accueille un lien aligné avec l'introduction sur grand écran.
 */
interface Props {
  label: string;
  title: string;
  intro?: string | undefined;
  id?: string | undefined;
  class?: string | undefined;
}

const { label, title, intro, id, class: className } = Astro.props;
const hasAside = Boolean(intro) || Astro.slots.has('aside');
---

<header class:list={['grid gap-5 lg:grid-cols-12 lg:items-end lg:gap-x-12', className]}>
  <div class="flex flex-col gap-4 lg:col-span-7">
    <p class="eyebrow" data-anim="reveal-up">
      {label}
    </p>
    <h2 id={id} class="type-h2 max-w-[24ch]" data-anim="reveal-lines">
      {title}
    </h2>
  </div>
  {hasAside && (
    <div
      class="flex flex-col items-start gap-4 lg:col-span-5 lg:pb-1"
      data-anim="reveal-up"
      data-anim-delay="0.1"
    >
      {intro && <p class="max-w-[46ch] text-fg-muted">{intro}</p>}
      <slot name="aside" />
    </div>
  )}
</header>
