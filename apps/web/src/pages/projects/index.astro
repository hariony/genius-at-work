---
import PageHero from '@/components/sections/PageHero.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { PROJECTS_PAGE } from '@/content/pages';
import { toLocale } from '@/lib/i18n';
import ProjectsIndex from '@/sections/projects/ProjectsIndex.astro';

const copy = PROJECTS_PAGE[toLocale(Astro.currentLocale)];
---

<PageLayout title={copy.hero.seoTitle} description={copy.hero.seoDescription}>
  <PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} lead={copy.hero.lead} />
  <ProjectsIndex />
</PageLayout>
