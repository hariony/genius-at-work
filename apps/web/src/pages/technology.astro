---
import PageHero from '@/components/sections/PageHero.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { TECHNOLOGY_PAGE } from '@/content/pages';
import { toLocale } from '@/lib/i18n';
import Engineering from '@/sections/technology/Engineering.astro';
import Principles from '@/sections/technology/Principles.astro';
import TechnologyUsage from '@/sections/technology/TechnologyUsage.astro';

const locale = toLocale(Astro.currentLocale);
const copy = TECHNOLOGY_PAGE[locale];
---

<PageLayout title={copy.hero.seoTitle} description={copy.hero.seoDescription}>
  <PageHero
    eyebrow={copy.hero.eyebrow}
    title={copy.hero.title}
    lead={copy.hero.lead}
    size="large"
  />
  <TechnologyUsage index="01" />
  <Engineering index="02" surface="subtle" />
  <Principles index="03" />
</PageLayout>
