---
import PageHero from '@/components/sections/PageHero.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { ABOUT_PAGE } from '@/content/pages';
import { toLocale } from '@/lib/i18n';
import Offices from '@/sections/about/Offices.astro';
import Story from '@/sections/about/Story.astro';
import Values from '@/sections/about/Values.astro';
import Method from '@/sections/home/Method.astro';
import Reasons from '@/sections/home/Reasons.astro';

const copy = ABOUT_PAGE[toLocale(Astro.currentLocale)];
---

<PageLayout title={copy.hero.seoTitle} description={copy.hero.seoDescription}>
  <PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} lead={copy.hero.lead} />
  <Story />
  <Values />
  <Offices />
  <Method surface="base" />
  <Reasons surface="subtle" />
</PageLayout>
