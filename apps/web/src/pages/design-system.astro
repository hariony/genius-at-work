---
/**
 * Design system vivant « Sous charge » (interne, noindex, hors sitemap).
 * Chaque exemple utilise les classes du site ; les contrastes sont calculés au build.
 * Règles écrites : docs/design-system.md.
 */
import AiTrace from '@/components/sections/AiTrace.astro';
import ChapterHeader from '@/components/sections/ChapterHeader.astro';
import ProjectCard from '@/components/sections/ProjectCard.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Tag from '@/components/ui/Tag.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { getFeaturedProjects } from '@/services/content';

/** Contraste WCAG entre deux couleurs hexadécimales. */
function contrast(a: string, b: string): string {
  const luminance = (hex: string) => {
    const [r = 0, g = 0, bl = 0] = [1, 3, 5].map((i) => {
      const c = Number.parseInt(hex.slice(i, i + 2), 16) / 255;
      return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
    });
    return 0.2126 * r + 0.7152 * g + 0.0722 * bl;
  };
  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x) as [number, number];
  return ((hi + 0.05) / (lo + 0.05)).toFixed(1).replace('.', ',');
}

const HEX = {
  paper: '#F6F5F1',
  sand: '#EDECE6',
  white: '#FFFFFF',
  ink: '#0A0B1E',
  night: '#07081A',
  slate: '#5B5E70',
  mist: '#A3A6BD',
  blue: '#1F4BFF',
  cyan: '#00C2FF',
  lilac: '#A98BFF',
  lime: '#C8F031',
  vermillion: '#FF5A36',
  vermillionDeep: '#C93410',
};

const GROUPS = [
  {
    title: 'Neutres',
    colors: [
      {
        token: 'paper',
        hex: HEX.paper,
        role: 'Fond jour',
        check: `encre ${contrast(HEX.ink, HEX.paper)}`,
      },
      {
        token: 'sand',
        hex: HEX.sand,
        role: 'Fond alterné',
        check: `ardoise ${contrast(HEX.slate, HEX.sand)}`,
      },
      {
        token: 'ink',
        hex: HEX.ink,
        role: 'Texte jour',
        check: `sur papier ${contrast(HEX.ink, HEX.paper)}`,
      },
      {
        token: 'night',
        hex: HEX.night,
        role: 'Fond nuit',
        check: `texte ${contrast('#F4F3EE', HEX.night)}`,
      },
      {
        token: 'slate',
        hex: HEX.slate,
        role: 'Texte secondaire jour',
        check: `sur papier ${contrast(HEX.slate, HEX.paper)}`,
      },
      {
        token: 'mist',
        hex: HEX.mist,
        role: 'Texte secondaire nuit',
        check: `sur nuit ${contrast(HEX.mist, HEX.night)}`,
      },
    ],
  },
  {
    title: 'Signal',
    colors: [
      {
        token: 'blue',
        hex: HEX.blue,
        role: 'Action et mot clé, jour',
        check: `sur papier ${contrast(HEX.blue, HEX.paper)} · blanc dessus ${contrast(HEX.white, HEX.blue)}`,
      },
      {
        token: 'cyan',
        hex: HEX.cyan,
        role: 'Action et mot clé, nuit',
        check: `sur nuit ${contrast(HEX.cyan, HEX.night)} · encre dessus ${contrast(HEX.ink, HEX.cyan)}`,
      },
    ],
  },
  {
    title: 'Vives (aplats, avec de l’encre dessus)',
    colors: [
      {
        token: 'cyan',
        hex: HEX.cyan,
        role: 'Aplat de projet, pastille',
        check: `encre dessus ${contrast(HEX.ink, HEX.cyan)}`,
      },
      {
        token: 'lilac',
        hex: HEX.lilac,
        role: 'Aplat de projet, pastille',
        check: `encre dessus ${contrast(HEX.ink, HEX.lilac)}`,
      },
      {
        token: 'lime',
        hex: HEX.lime,
        role: 'Surligneur, appel du pied de page',
        check: `encre dessus ${contrast(HEX.ink, HEX.lime)}`,
      },
    ],
  },
  {
    title: 'Vermillon (rare)',
    colors: [
      {
        token: 'vermillion',
        hex: HEX.vermillion,
        role: 'Charge, refus · nuit',
        check: `sur nuit ${contrast(HEX.vermillion, HEX.night)}`,
      },
      {
        token: 'vermillion-deep',
        hex: HEX.vermillionDeep,
        role: 'Charge, refus · jour',
        check: `sur papier ${contrast(HEX.vermillionDeep, HEX.paper)}`,
      },
    ],
  },
];

const TYPE_SCALE = [
  {
    cls: 'type-display',
    name: 'display · Manrope 800',
    sample: 'Des produits qui tiennent la charge.',
  },
  { cls: 'type-h1', name: 'h1 · Manrope 800', sample: 'L’ingénierie derrière nos produits' },
  { cls: 'type-h2', name: 'h2 · Manrope 700', sample: 'Du besoin métier à la production' },
  { cls: 'type-h3', name: 'h3 · Manrope 700', sample: 'Application mobile' },
  {
    cls: 'type-lead',
    name: 'lead',
    sample: 'Sites, applications web et mobiles, logiciels métier et e-commerce.',
  },
  {
    cls: 'text-body',
    name: 'body',
    sample:
      'Le texte courant reste en Manrope, graisse normale, 16 px, interligne 1,65 : la lecture prime.',
  },
  { cls: 'type-label', name: 'label · JetBrains Mono', sample: 'Navigation · Bureau · Cadrage' },
  {
    cls: 'type-mono',
    name: 'mono · JetBrains Mono',
    sample: '01 · 14:32 à Antananarivo · 1 248 requêtes simulées',
  },
];

const MOTION = [
  {
    title: 'Une seule animation continue par écran',
    text: 'Le hero ou le schéma IA, jamais deux à la fois. Elle s’arrête hors de l’écran et quand l’onglet est masqué.',
  },
  {
    title: 'Le reste joue une fois',
    text: 'Révélations à l’entrée (reveal-up, reveal-lines, stagger, stack, reveal-image), puis plus rien ne bouge. Entre deux pages, la nouvelle s’ouvre dans un « @ ».',
  },
  {
    title: 'Le défilement reste libre',
    text: 'Aucun épinglage, aucune vitesse imposée : une animation liée au défilement (chaîne IA) suit, elle ne retient pas.',
  },
  {
    title: 'Mouvement réduit',
    text: 'Si le système le demande : état fixe complet, rien n’est caché, rien ne manque.',
  },
];

const SURFACES = ['base', 'subtle', 'night'] as const;
const [project] = getFeaturedProjects();
---

<PageLayout
  title="Design system"
  description="Design system interne du site Genius At Work."
  noindex
>
  <Container class="flex flex-col gap-section-gap pt-32 pb-section">
    <header class="flex flex-col gap-5">
      <p class="eyebrow">Interne · Design system</p>
      <h1 class="type-h1 max-w-[20ch]" data-anim="reveal-lines" data-anim-trigger="load">
        Sous <span class="mark">charge</span>
      </h1>
      <p class="type-lead max-w-[60ch]">
        Neutres, un signal, des aplats vifs avec de l’encre dessus, un vermillon rare. Manrope pour
        lire, JetBrains Mono pour le système. Chaque exemple de cette page utilise les classes du
        site.
      </p>
    </header>

    <section class="flex flex-col gap-8" aria-labelledby="ds-colors">
      <h2 id="ds-colors" class="type-h2">
        Couleurs
      </h2>
      {GROUPS.map((group) => (
        <div class="flex flex-col gap-3">
          <h3 class="type-label text-fg-muted">{group.title}</h3>
          <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6" data-anim="stagger">
            {group.colors.map((color) => (
              <li class="flex flex-col overflow-hidden rounded-sm border border-border bg-bg-raised">
                <span class="h-16 border-b border-border" style={`background:${color.hex}`} />
                <span class="flex flex-col gap-1 p-3">
                  <span class="font-semibold">{color.token}</span>
                  <span class="text-small text-fg-muted">{color.role}</span>
                  <span class="type-mono text-fg-muted">{color.hex}</span>
                  <span class="type-mono text-fg-muted">{color.check} : 1</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="ds-type">
      <h2 id="ds-type" class="type-h2">
        Typographie
      </h2>
      <div class="flex flex-col divide-y divide-border border-y border-border">
        {TYPE_SCALE.map((row) => (
          <div class="grid gap-3 py-6 md:grid-cols-[14rem_minmax(0,1fr)] md:items-baseline">
            <span class="type-mono text-fg-muted">{row.name}</span>
            <span class={row.cls}>{row.sample}</span>
          </div>
        ))}
      </div>
    </section>
  </Container>

  {SURFACES.map((surface) => (
    <section
      data-surface={surface}
      class="border-t border-border py-section-gap"
      aria-label={`Composants sur la surface ${surface}`}
    >
      <Container class="flex flex-col gap-12">
        <ChapterHeader
          label={`Surface · ${surface}`}
          title="Boutons, étiquettes, repères"
          intro="Les couleurs suivent la surface : rien n’est réglé composant par composant."
        />
        <div class="grid gap-12 lg:grid-cols-2">
          <div class="flex flex-col gap-8">
            <div class="flex flex-wrap items-center gap-4">
              <Button href="#ds-colors" variant="accent">
                Parler de votre projet
              </Button>
              <Button href="#ds-type">Primaire</Button>
              <Button href="#ds-type" variant="outline" icon={false}>
                Contour
              </Button>
              <Button href="#ds-type" variant="secondary">
                Voir les réalisations
              </Button>
            </div>
            <div class="flex flex-wrap gap-1.5">
              <Tag>Astro</Tag>
              <Tag>Symfony</Tag>
              <Tag>API Platform</Tag>
            </div>
            <ol class="grid gap-x-8 gap-y-6 sm:grid-cols-3">
              {['Cadrer', 'Construire', 'Superviser'].map((step, i) => (
                <li class="flex flex-col gap-2 border-t border-border-strong pt-4">
                  <span class="type-mono text-highlight">{String(i + 1).padStart(2, '0')}</span>
                  <span class="font-bold">{step}</span>
                </li>
              ))}
            </ol>
            <label class="flex max-w-sm flex-col gap-2">
              <span class="type-label">Nom</span>
              <input class="field" type="text" placeholder="Votre nom" />
            </label>
          </div>
          {surface === 'night' ? (
            <AiTrace />
          ) : (
            project && <ProjectCard project={project} variant="feature" />
          )}
        </div>
      </Container>
    </section>
  ))}

  <section data-surface="subtle" class="py-section-gap" aria-labelledby="ds-motion">
    <Container class="flex flex-col gap-10">
      <ChapterHeader
        label="Mouvement"
        title="Peu, et jamais pour rien."
        intro="Presets déclarés par attribut data-anim, scènes par data-scene (src/animations)."
        id="ds-motion"
      />
      <ol class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4" data-anim="stagger">
        {MOTION.map((rule, i) => (
          <li class="flex flex-col gap-2 border-t border-border-strong pt-5">
            <span class="type-mono text-highlight">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="type-h3">{rule.title}</h3>
            <p class="text-fg-muted">{rule.text}</p>
          </li>
        ))}
      </ol>
    </Container>
  </section>
</PageLayout>
